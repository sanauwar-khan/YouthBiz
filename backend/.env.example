PORT=4000
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/youthbiz?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_JWT_EXPIRES_IN=1d
# Set permanent Admin credentials in backend/.env and keep them out of source control.
# ADMIN_PASSWORD must be at least 16 characters and no more than 72 UTF-8 bytes.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
